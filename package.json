{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test:browser": "node tests/Browser/input-protection.mjs",
        "test:blackbox": "node tests/Browser/black-box.mjs",
        "test:blackbox:report": "node tests/Browser/black-box.mjs && node tests/BlackBox/generate-report.mjs",
        "test:whitebox:report": "php artisan test --log-junit tests/reports/results/whitebox.xml --testdox-text tests/reports/results/whitebox-testdox.txt && node tests/WhiteBox/generate-report.mjs"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "concurrently": "^9.0.1",
        "docx": "^9.12.0",
        "laravel-vite-plugin": "^3.1",
        "playwright-core": "^1.63.0",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.1.0",
        "vite": "^8.0.0"
    }
}
